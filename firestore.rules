rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{document} {
      // Anyone can view the projects
      allow read: if true;
      // Only the specific admin email can modify projects
      allow write: if request.auth != null && request.auth.token.email == "bakirmannarkkad170@gmail.com";
    }
  }
}
